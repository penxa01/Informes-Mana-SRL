# Copiar a .env (no versionarlo) y completar.
# Mismas variables que usa el módulo Pedidos de la PC, pero con el rol movil_api
# (creado por movil/migraciones.py) en vez de postgres.
PEDIDOS_DB_HOST=localhost
PEDIDOS_DB_NAME=pedidosMana
PEDIDOS_DB_USER=movil_api
PEDIDOS_DB_PASSWORD=

# Secreto para firmar el token de sesión del celular. Cualquier cadena larga
# y al azar; si se cambia, se desloguean todos los celulares.
MOVIL_JWT_SECRET=

# Panel de control (movil/panel/worker.py), opcionales:
# PANEL_BASE_PATH=D:/tiempo      carpeta del sistema de gestion (los DBF y Thalamus/LITROS SHELL.xlsx)
# PANEL_INTERVALO_SEG=300        cada cuanto mira si hay datos nuevos
